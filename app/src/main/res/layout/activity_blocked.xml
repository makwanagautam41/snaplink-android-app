<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:paddingHorizontal="4dp"
        android:background="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFF"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Blocked"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:letterSpacing="0.01"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Thin Divider below top bar -->
    <View
        android:id="@+id/dividerTop"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:background="#1C1C1E"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Blocked Users List -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/dividerTop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp">

            <!-- Blocked User Row 1 -->
            <LinearLayout
                android:id="@+id/blockedUser1Row"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Avatar -->
                <ImageView
                    android:id="@+id/avatarUser1"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/img_current_user"
                    android:background="@drawable/circle_bg"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true" />

                <!-- Username -->
                <TextView
                    android:id="@+id/usernameUser1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="paril.alir"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Unblock Button -->
                <TextView
                    android:id="@+id/btnUnblockUser1"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Unblock"
                    android:textColor="#FFFFFF"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/btn_unblock"
                    android:textAllCaps="false" />

            </LinearLayout>

            <!-- Blocked User Row 2 -->
            <LinearLayout
                android:id="@+id/blockedUser2Row"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Avatar -->
                <ImageView
                    android:id="@+id/avatarUser2"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/img_current_user"
                    android:background="@drawable/circle_bg"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true" />

                <!-- Username -->
                <TextView
                    android:id="@+id/usernameUser2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="brucejoost"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Unblock Button -->
                <TextView
                    android:id="@+id/btnUnblockUser2"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Unblock"
                    android:textColor="#888888"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/btn_unblock"
                    android:textAllCaps="false" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>