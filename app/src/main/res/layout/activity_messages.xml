<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/tvInbox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Chats"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/searchContainer"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/search_bar_bg"
        app:layout_constraintTop_toBottomOf="@id/tvInbox"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="13dp"
            android:src="@drawable/ic_search_filled"
            android:alpha="0.4" />

        <EditText
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Search..."
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:textSize="14sp"
            android:paddingStart="44dp"
            android:paddingEnd="14dp"
            android:background="@null"
            android:singleLine="true"
            android:inputType="text" />

    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/storiesScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/searchContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/storiesContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp" />

    </HorizontalScrollView>

    <View
        android:id="@+id/separator"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#1E1E1E"
        app:layout_constraintTop_toBottomOf="@id/storiesScroll" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/separator"
        app:layout_constraintBottom_toTopOf="@id/navDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <View
        android:id="@+id/navDivider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="#222222"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation" />

    <!-- BOTTOM NAVIGATION — each icon wrapped in a
         FrameLayout so gravity="center" works for
         every item independently, including the
         CircleImageView which has a fixed dp size. -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:contentDescription="Home"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_home" />

        <ImageView
            android:id="@+id/navSearch"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:contentDescription="Search"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_search" />

        <ImageView
            android:id="@+id/navAdd"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:contentDescription="Add Post"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_add_post" />

        <ImageView
            android:id="@+id/navMessage"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:contentDescription="Messages"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chat_filled" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:scaleType="centerCrop"
            android:src="@drawable/img_current_user"
            app:civ_border_color="#FFFFFF"
            app:civ_border_width="1dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>