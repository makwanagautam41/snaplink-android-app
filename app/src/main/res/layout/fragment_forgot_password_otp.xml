<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:src="@drawable/ic_back"
            app:tint="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Verify OTP"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter sended OTP to your mail and verify it to reset your password."
            android:textColor="#4F6DFF"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter OTP Sent to Your Email"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- OTP Boxes -->
        <LinearLayout
            android:id="@+id/otpContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">

            <!-- Repeat 6 times -->
            <EditText
                android:id="@+id/otp1"
                style="@style/OtpBoxStyle"/>

            <EditText
                android:id="@+id/otp2"
                style="@style/OtpBoxStyle"/>

            <EditText
                android:id="@+id/otp3"
                style="@style/OtpBoxStyle"/>

            <EditText
                android:id="@+id/otp4"
                style="@style/OtpBoxStyle"/>

            <EditText
                android:id="@+id/otp5"
                style="@style/OtpBoxStyle"/>

            <EditText
                android:id="@+id/otp6"
                style="@style/OtpBoxStyle"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnVerifyOtp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Verify OTP"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resend in 27s"
            android:textColor="#4F6DFF"
            android:textSize="14sp"
            android:layout_marginTop="20dp"
            android:layout_gravity="center_horizontal"/>

        <TextView
            android:id="@+id/tvOtpSent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OTP has been sent to your email address"
            android:textColor="#00C853"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="16dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>